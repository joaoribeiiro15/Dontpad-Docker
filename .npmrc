# Nenhuma dependência precisa de scripts de instalação. O better-sqlite3 traz binários N-API já
# compilados (prebuilds/), mas inclui um binding.gyp que leva o npm a tentar "node-gyp rebuild",
# o que exige Python e um compilador de C++. "npm test", "npm start" e "npm run" continuam a correr.
ignore-scripts=true
