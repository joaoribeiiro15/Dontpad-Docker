# Copy to .env to change the values used by docker-compose.yml. Everything is optional.

# Port published on the host (inside the container it is always 3000).
HOST_PORT=3000

# Name shown on the home page and in browser tab titles.
APP_NAME=openpad

# Fallback polling interval, in milliseconds, used only while the live connection is down.
SYNC_INTERVAL_MS=5000

# Timeout for browser requests, in milliseconds.
REQUEST_TIMEOUT_MS=10000

# Maximum text size of one page, in UTF-8 bytes.
MAX_BODY_BYTES=1048576

# Maximum subpage depth (/a/b/c is 3).
MAX_DEPTH=10

# API requests per IP per minute.
RATE_LIMIT_PER_MIN=600

# Open live-update connections per IP (one per open tab).
MAX_STREAMS_PER_IP=20

# Public address shown on the home page and used in copied links, e.g. notes.example.com
# or 192.168.1.20:3000. Leave empty to be asked once on the home page (saved in /data).
PUBLIC_ADDRESS=

# Shared files (drag and drop). They live only in memory and are lost on restart.
# Largest file, in bytes (10 MB).
MAX_FILE_BYTES=10485760
# Files on one page at a time.
MAX_FILES_PER_PAGE=20
# Memory for all shared files together, in bytes (256 MB).
MAX_FILES_TOTAL_BYTES=268435456
# How long a file lives, in milliseconds (6 hours).
FILE_TTL_MS=21600000

# true when a reverse proxy sits in front (reads the client IP from X-Forwarded-For).
TRUST_PROXY=false

# debug | info | warn | error
LOG_LEVEL=info
