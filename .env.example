# Copia para .env para mudar os valores do docker-compose.yml. Tudo é opcional.

# Porto publicado no host (dentro do contentor é sempre 3000).
HOST_PORT=3000

# Nome mostrado na página inicial e no título dos separadores.
APP_NAME=openpad

# Ciclo de sincronização e timeout dos pedidos no browser, em milissegundos.
SYNC_INTERVAL_MS=5000
REQUEST_TIMEOUT_MS=10000

# Tamanho máximo do texto de uma página, em bytes UTF-8.
MAX_BODY_BYTES=1048576

# Níveis máximos de subpáginas (/a/b/c tem 3).
MAX_DEPTH=10

# Pedidos à API por IP e por minuto.
RATE_LIMIT_PER_MIN=120

# true quando há um proxy inverso à frente (lê o IP de X-Forwarded-For).
TRUST_PROXY=false

# debug | info | warn | error
LOG_LEVEL=info
